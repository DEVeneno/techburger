<mxfile host="app.diagrams.net"><diagram id="Wireframes___Cozinha" name="Wireframes · Cozinha"><mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="" style="rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#404040;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="360" height="680" as="geometry"/></mxCell><mxCell id="c2" value="Painel da cozinha (tablet)" style="rounded=0;fillColor=#E7E6E6;strokeColor=#808080;fontSize=17;fontStyle=1;fontColor=#404040;fontFamily=Calibri;" vertex="1" parent="1"><mxGeometry x="12" y="14" width="336" height="50" as="geometry"/></mxCell><mxCell id="c3" value="" style="rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#404040;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="420" y="0" width="360" height="680" as="geometry"/></mxCell><mxCell id="c4" value="Acompanhar o pedido (celular do cliente)" style="rounded=0;fillColor=#E7E6E6;strokeColor=#808080;fontSize=17;fontStyle=1;fontColor=#404040;fontFamily=Calibri;" vertex="1" parent="1"><mxGeometry x="432" y="14" width="336" height="50" as="geometry"/></mxCell><mxCell id="c5" value="Ponto de partida do Squad Cozinha (wireframes).&#xa;1. Uma tela por moldura (o nome no topo já é a sugestão)&#xa;2. Baixa fidelidade: só cinza, caixas, linhas e texto&#xa;3. UMA ação principal em destaque por tela&#xa;4. Os textos das regras na tela (ex.: &quot;Faltam R$ 3,00&quot;)&#xa;5. Uma nota ligando cada decisão à persona ou à regra&#xa;Precisa de mais telas? Ctrl+D duplica a moldura.&#xa;Apague esta nota quando terminar." style="shape=note;size=12;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=10;fontSize=15;fontColor=#333333;fontFamily=Calibri;" vertex="1" parent="1"><mxGeometry x="860" y="0" width="470" height="230" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>